local function setSelectedShotTools(selection)
    table.clear(selectedShotTools)

    if type(selection) == "table" then
        for _, name in ipairs(selection) do
            if name == "Freeze Ray" or name == "Paintball Gun" then
                selectedShotTools[name] = true
            end
        end
    elseif type(selection) == "string" then
        if selection == "Freeze Ray" or selection == "Paintball Gun" then
            selectedShotTools[selection] = true
        end
    end

    if next(selectedShotTools) == nil then
        stopSharedShotButton()
        return
    end

    if not shotGui or not shotGui.Parent then
        shotGui, shotButton, shotOutline = createShotButton()
        shotButton.Activated:Connect(fireSelectedTools)
    end

    updateShotButtonStyle()

    if selectedShotTools["Freeze Ray"] then
        if not shotHolder or not shotHolder.Parent then
            shotHolder = Instance.new("Part")
            shotHolder.Name = "HH_WeaponShotTarget"
            shotHolder.Size = Vector3.new(0.1, 0.1, 0.1)
            shotHolder.Transparency = 1
            shotHolder.Anchored = true
            shotHolder.CanCollide = false
            shotHolder.CanTouch = false
            shotHolder.CanQuery = false
            shotHolder.Parent = workspace

            shotTargetAttachment = Instance.new("Attachment")
            shotTargetAttachment.Parent = shotHolder

            shotBeam = Instance.new("Beam")
            shotBeam.Name = "HH_FreezeRayBeam"
            shotBeam.Attachment1 = shotTargetAttachment
            shotBeam.Color = ColorSequence.new(SHOT_CONFIG.FreezeBeamColor)
            shotBeam.Width0 = 0.055
            shotBeam.Width1 = 0.025
            shotBeam.FaceCamera = true
            shotBeam.LightEmission = 1
            shotBeam.Enabled = false
            shotBeam.Parent = shotHolder
        end
    else
        if shotHolder then
            shotHolder:Destroy()
        end
        shotHolder = nil
        shotTargetAttachment = nil
        shotBeam = nil
    end

    disconnect(shotConnection)
    shotConnection = nil

    if selectedShotTools["Freeze Ray"] then
        local elapsed = 0
        shotConnection = RunService.RenderStepped:Connect(function(dt)
            elapsed += dt
            if elapsed < SHOT_CONFIG.UpdateRate then
                return
            end
            elapsed = 0

            local tool, attachment = getFreezeParts()
            if not tool or not attachment then
                updateShotBeam(nil)
                return
            end

            local target = getShotTarget(
                attachment.WorldPosition,
                tool,
                SHOT_CONFIG.FreezeMaxDistance,
                true,
                false
            )
            updateShotBeam(target)
        end)
    end
end

