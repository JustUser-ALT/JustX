local fogSnapshot
local atmosphereSnapshots = {}
local fogDescendantConnection

local function disableAtmosphere(object)
    if not object:IsA("Atmosphere") then
        return
    end

    if not atmosphereSnapshots[object] then
        atmosphereSnapshots[object] = {
            Density = object.Density,
            Haze = object.Haze,
            Glare = object.Glare
        }
    end

    object.Density = 0
    object.Haze = 0
    object.Glare = 0
end

local function setDeleteFog(enabled)
    fogEnabled = enabled
    disconnect(fogDescendantConnection)
    fogDescendantConnection = nil

    if enabled then
        fogSnapshot = {
            FogStart = Lighting.FogStart,
            FogEnd = Lighting.FogEnd
        }

        table.clear(atmosphereSnapshots)

        for _, object in ipairs(Lighting:GetDescendants()) do
            disableAtmosphere(object)
        end

        Lighting.FogStart = 0
        Lighting.FogEnd = 1000000

        fogDescendantConnection = Lighting.DescendantAdded:Connect(function(object)
            if fogEnabled then
                disableAtmosphere(object)
            end
        end)

        task.spawn(function()
            while fogEnabled and JL:IsAlive() do
                Lighting.FogStart = 0
                Lighting.FogEnd = 1000000

                for _, object in ipairs(Lighting:GetDescendants()) do
                    if object:IsA("Atmosphere") then
                        disableAtmosphere(object)
                    end
                end

                task.wait(0.25)
            end
        end)
    else
        if fogSnapshot then
            Lighting.FogStart = fogSnapshot.FogStart
            Lighting.FogEnd = fullbrightEnabled and 100000 or fogSnapshot.FogEnd
        end

        for object, values in pairs(atmosphereSnapshots) do
            if object.Parent then
                object.Density = values.Density
                object.Haze = values.Haze
                object.Glare = values.Glare
            end
        end

        fogSnapshot = nil
        table.clear(atmosphereSnapshots)
    end
end

