local function hideMysteryGui(gui)
    if not mysteryGuiHidden or gui.Name ~= "MysteryGui" or not gui:IsA("ScreenGui") then
        return
    end

    if mysteryGuiStates[gui] == nil then
        mysteryGuiStates[gui] = gui.Enabled
    end

    gui.Enabled = false
end

