end

local function getFreezeParts()
    local tool = getSelectedTool("Freeze Ray")
    local handle = tool and tool:FindFirstChild("Handle")
    local attachment = handle and handle:FindFirstChild("Attachment")
    local remote = tool and tool:FindFirstChild("fire")

    if not tool or not attachment or not attachment:IsA("Attachment")
        or not remote or not remote:IsA("RemoteEvent") then
        return nil
    end

    return tool, attachment, remote
end

local function getPaintballParts()
    local tool = getSelectedTool("Paintball Gun")
    local handle = tool and tool:FindFirstChild("Handle")
    local muzzle = handle and handle:FindFirstChild("Muzzle")
    local remote = tool and tool:FindFirstChild("onFire")
    local stats = tool and tool:FindFirstChild("Stats")
    local range = stats and stats:FindFirstChild("Range")
    local rate = stats and stats:FindFirstChild("Rate")

    if not tool or not muzzle or not muzzle:IsA("Attachment")
        or not remote or not remote:IsA("RemoteEvent")
        or not range or not rate then
        return nil
    end

    return tool, muzzle, remote, range.Value, rate.Value
end

local function evaluateShotTarget(player, origin, tool, maxDistance, ignoreFrozen, requireHit)
    if player == LocalPlayer or not PlayerDetection.IsAlive(player) then
        return nil
    end

    if ignoreFrozen and PlayerDetection.IsFrozen(player) then
        return nil
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local camera = workspace.CurrentCamera

    if not humanoid or humanoid.Health <= 0 or not root or not camera then
        return nil
    end

    local offset = root.Position - origin
    local distance = offset.Magnitude
    if distance <= 0 or distance > maxDistance then
        return nil
    end

    local cameraOffset = root.Position - camera.CFrame.Position
    if cameraOffset.Magnitude <= 0 then
        return nil
    end

    local dot = math.clamp(camera.CFrame.LookVector:Dot(cameraOffset.Unit), -1, 1)
    local angle = math.deg(math.acos(dot))
    if angle > SHOT_CONFIG.MaxAimAngle then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character,
        tool
    }
    params.IgnoreWater = true

    local hit = workspace:Raycast(origin, offset, params)
    if (requireHit and not hit) or (hit and not hit.Instance:IsDescendantOf(character)) then
        return nil
    end

    return {
        Player = player,
        Part = root,
        Hit = hit,
        AimAngle = angle,
        Distance = distance
    }
end

local function getShotTarget(origin, tool, maxDistance, ignoreFrozen, requireHit)
    local best

    for _, player in ipairs(Players:GetPlayers()) do
        local result = evaluateShotTarget(player, origin, tool, maxDistance, ignoreFrozen, requireHit)
        if result and (not best
            or result.AimAngle < best.AimAngle
            or (result.AimAngle == best.AimAngle and result.Distance < best.Distance)) then
            best = result
        end
    end

    return best
end

