local playerEspEnabled = false
local espAllPlayers = false
local espTargets = {}
local espHighlights = {}
local playerConnections = {}
local playerDropdown

local sheriffEspEnabled = false
local murderEspEnabled = false

local function removeHighlight(player)
    local highlight = espHighlights[player]
    if highlight then
        pcall(function()
            highlight:Destroy()
        end)
        espHighlights[player] = nil
    end
end

local function hasRoleValue(player, role)
    local character = player.Character
    local containers = {player}

    if character then
        table.insert(containers, character)
    end

    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        table.insert(containers, backpack)
    end

    local roleNames
    if role == "Murder" then
        roleNames = {
            ismurderer = true,
            murder = true,
            murderer = true,
            knife = true,
            dagger = true
        }
    else
        roleNames = {
            issheriff = true,
            sheriff = true,
            revolver = true,
            sheriffgun = true
        }
    end

    for _, container in ipairs(containers) do
        if container then
            for attribute, value in pairs(container:GetAttributes()) do
                local key = tostring(attribute):lower():gsub("[%s_%-]", "")
                local text = tostring(value):lower()

                if role == "Murder" and (key == "role" or key == "team" or key == "class") and
                    (text:find("murder", 1, true) or text:find("killer", 1, true)) then
                    return true
                end

                if role == "Sheriff" and (key == "role" or key == "team" or key == "class") and
                    text:find("sheriff", 1, true) then
                    return true
                end

                if roleNames[key] and value == true then
                    return true
                end
            end

            for _, object in ipairs(container:GetDescendants()) do
                local key = object.Name:lower():gsub("[%s_%-]", "")

                if object:IsA("BoolValue") and roleNames[key] and object.Value then
                    return true
                end

                if object:IsA("StringValue") or object:IsA("ObjectValue") then
                    local value = tostring(object.Value):lower()
                    if role == "Murder" and
                        (key == "role" or key == "team" or key == "class") and
                        (value:find("murder", 1, true) or value:find("killer", 1, true)) then
                        return true
                    end
                    if role == "Sheriff" and
                        (key == "role" or key == "team" or key == "class") and
                        value:find("sheriff", 1, true) then
                        return true
                    end
                end

                if object:IsA("Tool") then
                    local name = object.Name:lower():gsub("[%s_%-]", "")
                    if role == "Murder" and
                        (name:find("murder", 1, true) or name:find("knife", 1, true) or name:find("dagger", 1, true)) then
                        return true
                    end
                    if role == "Sheriff" and
                        (name:find("sheriff", 1, true) or name:find("revolver", 1, true)) then
                        return true
                    end
                end
            end
        end
    end

    local team = player.Team
    if team then
        local name = team.Name:lower()
        if role == "Murder" and (name:find("murder", 1, true) or name:find("killer", 1, true)) then
            return true
        end
        if role == "Sheriff" and name:find("sheriff", 1, true) then
            return true
        end
    end

    return false
end

local function getHighlightColor(player)
    if murderEspEnabled and hasRoleValue(player, "Murder") then
        return Color3.fromRGB(255, 65, 75)
    end

    if sheriffEspEnabled and hasRoleValue(player, "Sheriff") then
        return Color3.fromRGB(255, 165, 55)
    end

    if playerEspEnabled and (espAllPlayers or espTargets[player.UserId]) then
        return Color3.fromRGB(90, 175, 255)
    end

    return nil
end

local function updatePlayerESP(player)
    if player == LocalPlayer then
        removeHighlight(player)
        return
    end

    local color = getHighlightColor(player)
    local character = player.Character

    if not color or not character then
        removeHighlight(player)
        return
    end

    local highlight = espHighlights[player]

    if not highlight or highlight.Parent ~= character then
        removeHighlight(player)

        highlight = Instance.new("Highlight")
        highlight.Name = "HH_PlayerESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0.05
        highlight.Parent = character

        espHighlights[player] = highlight
    end

    highlight.OutlineColor = color
end

local function updateAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        updatePlayerESP(player)
    end
end

local function getPlayerOptions()
    local options = {"All", {Divider = true}}
    local players = Players:GetPlayers()

    table.sort(players, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    for _, player in ipairs(players) do
        if player ~= LocalPlayer then
            table.insert(options, player.Name)
        end
    end

    return options
end

local function applyPlayerSelection(selection)
    selection = type(selection) == "table" and selection or {}

    local all = false
    local chosen = {}

    for _, name in ipairs(selection) do
        if name == "All" then
            all = true
        else
            chosen[name] = true
        end
    end

    if all and next(chosen) == nil then
        espAllPlayers = true
        table.clear(espTargets)
    else
        espAllPlayers = false
        table.clear(espTargets)

        for _, player in ipairs(Players:GetPlayers()) do
            if chosen[player.Name] then
                espTargets[player.UserId] = true
            end
        end
    end

    playerEspEnabled = espAllPlayers or next(espTargets) ~= nil
    updateAllESP()

    if all and next(chosen) ~= nil and playerDropdown then
        local names = {}

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and chosen[player.Name] then
                table.insert(names, player.Name)
            end
        end

        playerDropdown:Set(names)
    end
end

playerDropdown = Visual:Dropdown({
