local selectedGears = {}
local sinisterEnabled = false
local registeredPumpkins = {}

local function getGearOptions()
    return GearList
end

local function normalizeImage(image)
    image = tostring(image or ""):lower()
    return image:match("%d+") or image
end

local function isSelectedGearImage(image)
    local names = GearImageMap[normalizeImage(image)]
    if not names then
        return false
    end

    for _, name in ipairs(names) do
        if selectedGears[name] then
            return true, name
        end
    end

    return false
end

local function activatePrompt(prompt, model, icon)
    if not prompt or not prompt.Parent or not prompt.Enabled then
        return false
    end

    local imageBefore = icon and icon.Image

    pcall(function()
        prompt.HoldDuration = 0
    end)

    if type(fireproximityprompt) == "function" then
        local fired = pcall(function()
            fireproximityprompt(prompt)
        end)

        if fired then
            task.wait(0.15)

            if not prompt.Parent or not prompt.Enabled
                or not model.Parent
                or (icon and icon.Parent and icon.Image ~= imageBefore) then
                return true
            end
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end)
end

local function trySinisterClaim(model, prompt, icon)
    if not sinisterEnabled or not model or not model.Parent then
        return
    end

    local record = registeredPumpkins[model]
    if not record or record.Busy then
        return
    end

    local now = os.clock()
    if record.LastAttemptAt and now - record.LastAttemptAt < 0.8 then
        return
    end

    if not prompt or not prompt.Parent or not prompt.Enabled then
        return
    end

    if not icon or not icon.Parent then
        return
    end

    local matched, itemName = isSelectedGearImage(icon.Image)
    if not matched then
        return
    end

    record.Busy = true
    record.LastAttemptAt = now
    activatePrompt(prompt, model, icon)
    record.Busy = false
end

local function registerPumpkin(model)
    if not model or not model:IsA("Model") or registeredPumpkins[model] then
        return
    end

    local inner = model:FindFirstChild("Pumpkin")
    if not inner then
        return
    end

    local prompt = inner:FindFirstChild("ProximityPrompt", true)
    local billboard = inner:FindFirstChild("BillboardGui", true)
    local frame = billboard and billboard:FindFirstChild("Frame")
    local innerFrame = frame and frame:FindFirstChild("Frame")
    local icon = innerFrame and innerFrame:FindFirstChild("Icon")

    if not prompt or not billboard or not icon or not icon:IsA("ImageLabel") then
        return
    end

    registeredPumpkins[model] = {
        LastAttemptAt = 0,
        Connections = {}
    }

    local record = registeredPumpkins[model]

    table.insert(record.Connections, icon:GetPropertyChangedSignal("Image"):Connect(function()
        trySinisterClaim(model, prompt, icon)
    end))

    table.insert(record.Connections, prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
        trySinisterClaim(model, prompt, icon)
    end))

    table.insert(record.Connections, billboard:GetPropertyChangedSignal("Enabled"):Connect(function()
        trySinisterClaim(model, prompt, icon)
    end))

    task.defer(function()
        trySinisterClaim(model, prompt, icon)
    end)

    table.insert(record.Connections, model.AncestryChanged:Connect(function(_, parent)
        if parent then
            return
        end

        for _, connection in ipairs(record.Connections) do
            disconnect(connection)
        end

        registeredPumpkins[model] = nil
    end))
end

local Plates = workspace:FindFirstChild("Plates")

if Plates then
    local function registerPlate(plate)
        local existing = plate:FindFirstChild("Pumpkin")
        if existing then
            registerPumpkin(existing)
        end

        keepConnection(plate.DescendantAdded:Connect(function(object)
            local candidate = object
            while candidate and candidate.Parent ~= plate do
                candidate = candidate.Parent
            end

            if candidate and candidate.Parent == plate
                and candidate.Name == "Pumpkin"
                and candidate:IsA("Model") then
                task.delay(0.1, registerPumpkin, candidate)
            end
        end))
    end

    for _, plate in ipairs(Plates:GetChildren()) do
        registerPlate(plate)
    end

    keepConnection(Plates.ChildAdded:Connect(registerPlate))
end

