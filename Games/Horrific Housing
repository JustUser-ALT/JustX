local function updateFreezeBeam(target)
    local attachment = getFreezeAttachment()
    if not attachment or not target or not freezeBeam or not freezeHolder then
        if freezeBeam then
            freezeBeam.Enabled = false
        end
        return
    end

    freezeBeam.Attachment0 = attachment
    freezeHolder.Position = target.Part.Position
    freezeBeam.Enabled = true
end

local function fireFreezeRay()
    if not freezeEnabled then
        return
    end

    local now = os.clock()
    if now - freezeLastShot < FREEZE_CONFIG.Cooldown then
        return
    end

    local tool = getFreezeTool()
    local attachment = getFreezeAttachment()
    local remote = tool and tool:FindFirstChild("fire")

    if not tool or not attachment then
        return
    end

    if not remote or not remote:IsA("RemoteEvent") then
        return
    end

    local target = getFreezeTarget()
    if not target or not target.Part or not target.Part.Parent then
        return
    end

    local offset = target.Part.Position - attachment.WorldPosition
    if offset.Magnitude <= 0 then
        return
    end

    local direction = offset.Unit
    local fired = pcall(function()
        remote:FireServer(direction)
    end)

    if fired then
        freezeLastShot = now
        if freezeButton and freezeButton.Parent then
            local outline = freezeButton:FindFirstChildOfClass("UIStroke")
            if outline then
                outline.Color = Color3.fromRGB(220, 255, 225)
                task.delay(0.12, function()
                    if freezeEnabled and outline.Parent then
                        outline.Color = Color3.fromRGB(75, 220, 125)
                    end
                end)
            end
        end
    end
end

local function stopAutoFreezeRay()
    freezeEnabled = false
    disconnect(freezeConnection)
    freezeConnection = nil

    if freezeGui then
        freezeGui:Destroy()
    end

    if freezeHolder then
        freezeHolder:Destroy()
    end

    freezeGui = nil
    freezeButton = nil
    freezeHolder = nil
    freezeBeam = nil
    freezeTargetAttachment = nil
    freezePriorityPlayer = nil
    freezeLastShot = 0
end

local function setAutoFreezeRay(enabled)
    stopAutoFreezeRay()
    if not enabled then
        return
    end

    freezeEnabled = true
    freezeGui, freezeButton = createFreezeButton()
    freezeButton.Activated:Connect(fireFreezeRay)

    freezeHolder = Instance.new("Part")
    freezeHolder.Name = "HH_FreezeRayTarget"
    freezeHolder.Size = Vector3.new(0.1, 0.1, 0.1)
    freezeHolder.Transparency = 1
    freezeHolder.Anchored = true
    freezeHolder.CanCollide = false
    freezeHolder.CanTouch = false
    freezeHolder.CanQuery = false
    freezeHolder.Parent = workspace

    freezeTargetAttachment = Instance.new("Attachment")
    freezeTargetAttachment.Parent = freezeHolder

    freezeBeam = Instance.new("Beam")
    freezeBeam.Name = "HH_FreezeRayBeam"
    freezeBeam.Attachment1 = freezeTargetAttachment
    freezeBeam.Color = ColorSequence.new(FREEZE_CONFIG.BeamColor)
    freezeBeam.Width0 = 0.055
    freezeBeam.Width1 = 0.025
    freezeBeam.FaceCamera = true
    freezeBeam.LightEmission = 1
    freezeBeam.Enabled = false
    freezeBeam.Parent = freezeHolder

    local elapsed = 0
    freezeConnection = RunService.RenderStepped:Connect(function(dt)
        if not freezeEnabled then
            return
        end

        elapsed += dt
        if elapsed < FREEZE_CONFIG.UpdateRate then
            return
        end
        elapsed = 0

        local target = getFreezeTarget()
        updateFreezeBeam(target)
    end)
end

