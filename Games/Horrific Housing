local function getPumpkinRoot(object, plate)
    if not object then
        return nil
    end

    local candidate = object:IsA("Model") and object.Name == "Pumpkin"
        and object
        or object:FindFirstAncestor("Pumpkin")

    if not candidate or not candidate:IsA("Model") then
        return nil
    end

    while candidate.Parent and candidate.Parent ~= plate do
        local parent = candidate.Parent
        if parent:IsA("Model") and parent.Name == "Pumpkin" then
            candidate = parent
        else
            break
        end
    end

    return candidate
end

local sinisterPlateConnections = {}

local function registerPumpkinsIn(plate)
    for _, object in ipairs(plate:GetDescendants()) do
        if object.Name == "Pumpkin" and object:IsA("Model") then
            local root = getPumpkinRoot(object, plate)
            if root then
                registerPumpkin(root)
            end
        end
    end

    local direct = plate:FindFirstChild("Pumpkin")
    if direct and direct:IsA("Model") then
        registerPumpkin(direct)
    end
end

registerPlatesWatcher(function(folder, plate)
    if plate then
        registerPumpkinsIn(plate)
        table.insert(sinisterPlateConnections, plate.DescendantAdded:Connect(function(object)
            local candidate = getPumpkinRoot(object, plate)
            if candidate then
                task.defer(registerPumpkin, candidate)
            end
        end))
        return
    end

    for _, connection in ipairs(sinisterPlateConnections) do
        disconnect(connection)
    end
    table.clear(sinisterPlateConnections)

    for model, record in pairs(registeredPumpkins) do
        if not folder or not model:IsDescendantOf(folder) then
            for _, connection in ipairs(record.Connections or {}) do
                disconnect(connection)
            end
            registeredPumpkins[model] = nil
        end
    end
end)

