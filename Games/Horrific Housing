                if image ~= "" then
                    table.insert(GearList, tostring(name))
                    local key = image:lower():match("%d+") or image:lower()
                    GearImageMap[key] = GearImageMap[key] or {}
                    table.insert(GearImageMap[key], tostring(name))
                end
            end
        end

        table.sort(GearList, function(a, b)
            return a:lower() < b:lower()
        end)
    end)

    gearListReady = true
end)

local selectedGears = {}
local sinisterEnabled = false
local registeredPumpkins = {}

local function getGearOptions()
    return GearList
end

local function normalizeImage(image)
    image = tostring(image or ""):lower()
    return image:match("%d+") or image
end

local function isSelectedGearImage(image)
    local names = GearImageMap[normalizeImage(image)]
    if not names then
        return false
    end

    for _, name in ipairs(names) do
        if selectedGears[name] then
            return true, name
        end
    end

    return false
end

local function getPumpkinComponents(model)
    if not model or not model.Parent then
        return nil
    end

    local prompt
    local billboard
    local icon

    for _, object in ipairs(model:GetDescendants()) do
        if object:IsA("ProximityPrompt") and object.Enabled and not prompt then
            prompt = object
        elseif object:IsA("BillboardGui") and not billboard then
            billboard = object
        elseif object.Name == "Icon"
            and (object:IsA("ImageLabel") or object:IsA("ImageButton")) then
            icon = object
        end
    end

    if not prompt then
        prompt = findNamedDescendant(model, "ProximityPrompt", "ProximityPrompt")
    end

    if not icon and billboard then
        icon = findNamedDescendant(billboard, "Icon")
    end

    return prompt, billboard, icon
end

local function activatePrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then
        return false
    end

    if type(fireproximityprompt) == "function" then
        local fired = pcall(function()
            fireproximityprompt(prompt)
        end)

        if fired then
            task.wait(0.12)
        end
    end

    if not prompt.Parent or not prompt.Enabled then
        return true
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration, 0.05))
        prompt:InputHoldEnd()
    end)
end

local function trySinisterClaim(model)
    if not sinisterEnabled or not model or not model.Parent then
        return
    end

    local record = registeredPumpkins[model]
    if not record or record.Busy then
        return
    end

    local prompt, billboard, icon = getPumpkinComponents(model)
    if not prompt or not icon or not icon.Parent or not prompt.Enabled then
        return
    end

    if billboard and not billboard.Enabled then
        return
    end

    local matched = isSelectedGearImage(icon.Image)
    if not matched then
        return
    end

    local now = os.clock()
    if now - (record.LastAttemptAt or 0) < 0.45 then
        return
    end

    record.Busy = true
    record.LastAttemptAt = now
    activatePrompt(prompt)
    record.Busy = false
end

local function registerPumpkin(model)
    if not model or not model:IsA("Model") or registeredPumpkins[model] then
        return
    end

    registeredPumpkins[model] = {
        LastAttemptAt = 0,
        Busy = false,
        Connections = {}
    }

    local record = registeredPumpkins[model]

    table.insert(record.Connections, model.DescendantAdded:Connect(function()
        if sinisterEnabled then
            task.defer(trySinisterClaim, model)
        end
    end))

    table.insert(record.Connections, model.AncestryChanged:Connect(function(_, parent)
        if parent then
            return
        end

        for _, connection in ipairs(record.Connections) do
            disconnect(connection)
        end

        registeredPumpkins[model] = nil
    end))

    task.defer(trySinisterClaim, model)
end

local Plates = workspace:FindFirstChild("Plates")

if Plates then
    local function registerPumpkinsIn(plate)
        for _, object in ipairs(plate:GetDescendants()) do
            if object.Name == "Pumpkin" and object:IsA("Model") then
                registerPumpkin(object)
            end
        end

        local direct = plate:FindFirstChild("Pumpkin")
        if direct and direct:IsA("Model") then
            registerPumpkin(direct)
        end
    end

    local function registerPlate(plate)
        registerPumpkinsIn(plate)

        keepConnection(plate.DescendantAdded:Connect(function(object)
            if object.Name == "Pumpkin" and object:IsA("Model") then
                registerPumpkin(object)
            else
                local candidate = object:FindFirstAncestor("Pumpkin")
                if candidate and candidate:IsA("Model") then
                    task.defer(registerPumpkin, candidate)
                end
            end
        end))
    end

    for _, plate in ipairs(Plates:GetChildren()) do
        registerPlate(plate)
    end

    keepConnection(Plates.ChildAdded:Connect(registerPlate))
end

