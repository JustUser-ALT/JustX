        end
    end)
end

local function fireFreezeRay()
    local tool, attachment, remote = getFreezeParts()
    if not tool or not attachment or not remote then
        return false
    end

    local now = os.clock()
    if now - shotLastShots["Freeze Ray"] < SHOT_CONFIG.FreezeCooldown then
        return false
    end

    local target = getShotTarget(
        attachment.WorldPosition,
        tool,
        SHOT_CONFIG.FreezeMaxDistance,
        true,
        false
    )

    if not target or not target.Part or not target.Part.Parent then
        return false
    end

    local offset = target.Part.Position - attachment.WorldPosition
    if offset.Magnitude <= 0 then
        return false
    end

    local fired = pcall(function()
        remote:FireServer(offset.Unit)
    end)

    if fired then
        shotLastShots["Freeze Ray"] = now
        flashShotButton(Color3.fromRGB(220, 255, 225))
        return true
    end

    return false
end

local function firePaintball()
    local tool, muzzle, remote, maxDistance, rate = getPaintballParts()
    if not tool or not muzzle or not remote then
        return false
    end

    local now = os.clock()
    local cooldown = math.max(tonumber(rate) or 0, 0.05)
    if now - shotLastShots["Paintball Gun"] < cooldown then
        return false
    end

    local target = getShotTarget(muzzle.WorldPosition, tool, maxDistance, false, true)
    if not target or not target.Part or not target.Part.Parent or not target.Hit then
        return false
    end

    local origin = muzzle.WorldPosition
    local offset = target.Hit.Position - origin
    if offset.Magnitude <= 0 then
        return false
    end

    local hit = target.Hit
    local fired = pcall(function()
        remote:FireServer(origin, offset.Unit, {
            Position = hit.Position,
            Normal = hit.Normal,
            Instance = hit.Instance
        })
    end)

    if fired then
        shotLastShots["Paintball Gun"] = now
        flashShotButton(Color3.fromRGB(190, 235, 255))
        return true
    end

    return false
end

local function fireSelectedTools()
    if selectedShotTools["Freeze Ray"] then
        fireFreezeRay()
    end

    if selectedShotTools["Paintball Gun"] then
        firePaintball()
    end
end

