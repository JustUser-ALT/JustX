local treasureMapEspEnabled = false
local treasureMapObjects = {}
local treasureMapConnections = {}

local function findNamedDescendant(root, targetName, className)
    if not root then
        return nil
    end

    local wanted = targetName:lower()
    for _, object in ipairs(root:GetDescendants()) do
        if object.Name:lower() == wanted and (not className or object:IsA(className)) then
            return object
        end
    end
    return nil
end

local function isTreasureMapObject(object)
    if not object or not object.Parent or object.Name ~= "MapModel" then
        return false
    end

    if not (object:IsA("BasePart") or object:IsA("Model")) then
        return false
    end

    local prompt = findNamedDescendant(object, "ProximityPrompt", "ProximityPrompt")
    local rotation = findNamedDescendant(object, "rotationModule")
    return prompt ~= nil and rotation ~= nil
end

local function removeTreasureMapESP(object)
    local record = treasureMapObjects[object]
    if not record then
        return
    end

    disconnect(record.AncestryConnection)

    if record.Highlight then
        record.Highlight:Destroy()
    end

    if record.Billboard then
        record.Billboard:Destroy()
    end

    treasureMapObjects[object] = nil
end

local function addTreasureMapESP(object)
    if not treasureMapEspEnabled or treasureMapObjects[object]
        or not isTreasureMapObject(object) then
        return
    end

    local adornee = object:IsA("BasePart") and object
        or (object:IsA("Model") and (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)))

    if not adornee then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "HH_TreasureMapESP"
    highlight.Adornee = object
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(255, 190, 65)
    highlight.FillTransparency = 0.82
    highlight.OutlineColor = Color3.fromRGB(255, 205, 85)
    highlight.OutlineTransparency = 0
    highlight.Parent = object

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "HH_TreasureMapLabel"
    billboard.Adornee = adornee
    billboard.Size = UDim2.fromOffset(112, 22)
    billboard.StudsOffset = Vector3.new(0, 2.4, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 1500
    billboard.Parent = object

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = "TREASURE MAP"
    label.TextColor3 = Color3.fromRGB(255, 210, 105)
    label.TextStrokeColor3 = Color3.fromRGB(25, 18, 8)
    label.TextStrokeTransparency = 0.15
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Parent = billboard

    local record = {
        Highlight = highlight,
        Billboard = billboard
    }
    treasureMapObjects[object] = record

    record.AncestryConnection = object.AncestryChanged:Connect(function(_, parent)
        if not parent then
            removeTreasureMapESP(object)
        end
    end)
end

local function queueTreasureMapCheck(object)
    if not object then
        return
    end

    task.delay(0.15, function()
        if treasureMapEspEnabled and object.Parent then
            addTreasureMapESP(object)
        end
    end)
end

local function scanTreasureMaps(container)
    if not container then
        return
    end

    for _, object in ipairs(container:GetDescendants()) do
        if object.Name == "MapModel" then
            queueTreasureMapCheck(object)
        end
    end
end

local function updateTreasureMapESP()
    if not Plates then
        return
    end

    if treasureMapEspEnabled then
        scanTreasureMaps(Plates)
    else
        local objects = {}
        for object in pairs(treasureMapObjects) do
            table.insert(objects, object)
        end

        for _, object in ipairs(objects) do
            removeTreasureMapESP(object)
        end
    end
end

registerPlatesWatcher(function(folder, plate)
    if plate then
        table.insert(treasureMapConnections, plate.DescendantAdded:Connect(function(object)
            local candidate = object.Name == "MapModel"
                and object
                or object:FindFirstAncestor("MapModel")

            if candidate then
                queueTreasureMapCheck(candidate)
            end
        end))

        if treasureMapEspEnabled then
            scanTreasureMaps(plate)
        end
        return
    end

    for _, connection in ipairs(treasureMapConnections) do
        disconnect(connection)
    end
    table.clear(treasureMapConnections)

    if folder and treasureMapEspEnabled then
        scanTreasureMaps(folder)
    else
        local objects = {}
        for object in pairs(treasureMapObjects) do
            table.insert(objects, object)
        end
        for _, object in ipairs(objects) do
            removeTreasureMapESP(object)
        end
    end
end)

Visual:Toggle({
    Name = "Treasure Map ESP",
