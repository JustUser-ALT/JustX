local Connections = {}
local function keepConnection(connection)
    if connection then
        table.insert(Connections, connection)
    end
    return connection
end

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local fishEnabled = false
local fishConnection
local fishGui
local fishClicked = false

local function getGuiVisible(gui)
    if not gui or not gui.Parent then
        return false
    end
    if gui:IsA("ScreenGui") then
        return gui.Enabled
    end
    if gui:IsA("GuiObject") then
        return gui.Visible
    end
    return true
end

local function stopAutoFish()
    fishEnabled = false
    disconnect(fishConnection)
    fishConnection = nil
    fishGui = nil
    fishClicked = false
end

local function setAutoFish(enabled)
    fishEnabled = enabled
    disconnect(fishConnection)
    fishConnection = nil
    fishGui = nil
    fishClicked = false

    if not enabled then
        return
    end

    fishConnection = RunService.RenderStepped:Connect(function()
        if not fishEnabled then
            return
        end

        local gui = PlayerGui:FindFirstChild("FishMinigameGui")
        if not gui or not getGuiVisible(gui) then
            fishGui = nil
            fishClicked = false
            return
        end

        if fishGui ~= gui then
            fishGui = gui
            fishClicked = false
        end

        if fishClicked then
            return
        end

        local frame = gui:FindFirstChild("Frame")
        local canvas = frame and frame:FindFirstChild("CanvasGroup")
        local root = canvas and canvas:FindFirstChild("Frame")
        local marker = root and root:FindFirstChild("Marker")
        local core = root and root:FindFirstChild("Core")
        local perfect = core and core:FindFirstChild("Perfect")
        local button = gui:FindFirstChild("button", true)

        if not marker or not perfect or not button or not button:IsA("GuiButton") then
            return
        end

        local markerCenter = marker.AbsolutePosition + marker.AbsoluteSize / 2
        local perfectMin = perfect.AbsolutePosition
        local perfectMax = perfectMin + perfect.AbsoluteSize

        local inside =
            markerCenter.X >= perfectMin.X and
            markerCenter.X <= perfectMax.X and
            markerCenter.Y >= perfectMin.Y and
            markerCenter.Y <= perfectMax.Y

        if inside then
            local fired = pcall(function()
                firesignal(button.Activated)
            end)

            if not fired then
                fired = pcall(function()
                    button:Activate()
                end)
            end

            if fired then
                fishClicked = true
            end
        end
    end)
end

