local PlayerDetection = {}

local function getPlayerTeamName(player)
    local team = player and player.Team
    return team and team.Name or nil
end

function PlayerDetection.GetRoundState(player)
    local teamName = getPlayerTeamName(player)
    if teamName == "Playing" then
        return "Playing"
    end
    if teamName == "Lobby" then
        return "Lobby"
    end
    return teamName or "Unknown"
end

function PlayerDetection.IsAlive(player)
    if not player or PlayerDetection.GetRoundState(player) ~= "Playing" then
        return false
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

function PlayerDetection.IsFrozen(player)
    if not player then
        return false
    end

    local containers = {player}
    if player.Character then
        table.insert(containers, player.Character)
    end

    for _, container in ipairs(containers) do
        for attribute, value in pairs(container:GetAttributes()) do
            local key = tostring(attribute):lower():gsub("[%s_%-]", "")
            if key == "frozen" and value == true then
                return true
            end
            if (key == "status" or key == "effect" or key == "statuseffect")
                and tostring(value):lower():find("frozen", 1, true) then
                return true
            end
        end

        for _, object in ipairs(container:GetDescendants()) do
            local name = object.Name:lower():gsub("[%s_%-]", "")
            if name == "frozen" then
                if object:IsA("BoolValue") then
                    if object.Value then
                        return true
                    end
                else
                    return true
                end
            end

            for attribute, value in pairs(object:GetAttributes()) do
                local key = tostring(attribute):lower():gsub("[%s_%-]", "")
                if key == "frozen" and value == true then
                    return true
                end
                if (key == "status" or key == "effect" or key == "statuseffect")
                    and tostring(value):lower():find("frozen", 1, true) then
                    return true
                end
            end

            if object:IsA("StringValue") then
                local key = object.Name:lower():gsub("[%s_%-]", "")
                if (key == "status" or key == "effect" or key == "statuseffect")
                    and object.Value:lower():find("frozen", 1, true) then
                    return true
                end
            end
        end
    end

    return false
end

function PlayerDetection.GetState(player)
    return {
        Team = PlayerDetection.GetRoundState(player),
        Alive = PlayerDetection.IsAlive(player),
        Frozen = PlayerDetection.IsFrozen(player)
    }
end

local FREEZE_CONFIG = {
    MaxAimAngle = 42,
    MaxDistance = 300,
    UpdateRate = 0.05,
    Cooldown = 1.5,
    BeamColor = Color3.fromRGB(50, 255, 110)
}

local function getFreezeTool()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("Freeze Ray")
end

local function getFreezeAttachment()
    local tool = getFreezeTool()
    local handle = tool and tool:FindFirstChild("Handle")
    return handle and handle:FindFirstChild("Attachment")
end

local function getFreezeRoot(player)
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if humanoid and humanoid.Health > 0 and root then
        return root
    end
end

local function evaluateFreezeTarget(player)
    if player == LocalPlayer or not PlayerDetection.IsAlive(player)
        or PlayerDetection.IsFrozen(player) then
        return nil
    end

    local root = getFreezeRoot(player)
    local attachment = getFreezeAttachment()
    local camera = workspace.CurrentCamera
    if not root or not attachment or not camera then
        return nil
    end

    local offset = root.Position - attachment.WorldPosition
    local distance = offset.Magnitude
    if distance <= 0 or distance > FREEZE_CONFIG.MaxDistance then
        return nil
    end

    local cameraDirection = (root.Position - camera.CFrame.Position).Unit
    local dot = math.clamp(camera.CFrame.LookVector:Dot(cameraDirection), -1, 1)
    local angle = math.deg(math.acos(dot))
    if angle > FREEZE_CONFIG.MaxAimAngle then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character,
        getFreezeTool()
    }
    params.IgnoreWater = true

    local hit = workspace:Raycast(attachment.WorldPosition, offset, params)
    if hit and not hit.Instance:IsDescendantOf(player.Character) then
        return nil
    end

    return {
        Player = player,
        Part = root,
        AimAngle = angle,
        Distance = distance
    }
end

local function getFreezeTarget()
    if freezePriorityPlayer then
        local preferred = evaluateFreezeTarget(freezePriorityPlayer)
        if preferred then
            return preferred
        end
    end

    local best
    for _, player in ipairs(Players:GetPlayers()) do
        local result = evaluateFreezeTarget(player)
        if result and (not best
            or result.AimAngle < best.AimAngle
            or (result.AimAngle == best.AimAngle and result.Distance < best.Distance)) then
            best = result
        end
    end

    return best
end

