local fogEnabled = false
local fullbrightEnabled = false
local fullbrightSnapshot
local fullbrightConnection

local function applyFullbright()
    Lighting.Ambient = Color3.fromRGB(128, 128, 128)
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.FogStart = fogEnabled and 0 or Lighting.FogStart
    Lighting.FogEnd = fogEnabled and 1000000 or 100000
    Lighting.GlobalShadows = false
end

local function setFullbright(enabled)
    fullbrightEnabled = enabled
    disconnect(fullbrightConnection)
    fullbrightConnection = nil

    if enabled then
        fullbrightSnapshot = {
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            Brightness = Lighting.Brightness,
            ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd,
            GlobalShadows = Lighting.GlobalShadows
        }

        applyFullbright()

        fullbrightConnection = RunService.Heartbeat:Connect(function()
            if fullbrightEnabled then
                applyFullbright()
            end
        end)
    else
        if fullbrightSnapshot then
            Lighting.Ambient = fullbrightSnapshot.Ambient
            Lighting.OutdoorAmbient = fullbrightSnapshot.OutdoorAmbient
            Lighting.Brightness = fullbrightSnapshot.Brightness
            Lighting.ClockTime = fullbrightSnapshot.ClockTime
            Lighting.FogEnd = fullbrightSnapshot.FogEnd
            Lighting.GlobalShadows = fullbrightSnapshot.GlobalShadows
            if fogEnabled then
                Lighting.FogEnd = 1000000
            end
        end

        fullbrightSnapshot = nil
    end
end

